<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Settings"
            app:titleTextColor="@color/purple_on_surface"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/purple_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            style="@style/Widget.Zoron.Container"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== ENGINE DIAGNOSTICS ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE DIAGNOSTICS"
                style="@style/TextAppearance.Zoron.LabelLarge"
                android:layout_marginBottom="16dp" />

            <!-- Logging Mode -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logging Mode"
                        style="@style/TextAppearance.Zoron.TitleMedium"
                        android:textColor="@color/purple_primary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Controls the verbosity of engine logs"
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:layout_marginBottom="12dp" />

                    <Spinner
                        android:id="@+id/spinnerLogLevel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_pill_button_outlined"
                        android:paddingHorizontal="16dp"
                        android:popupBackground="@color/purple_surface_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Export Preferences -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export Preferences"
                        style="@style/TextAppearance.Zoron.TitleMedium"
                        android:textColor="@color/purple_primary"
                        android:layout_marginBottom="16dp" />

                    <!-- ZIP export switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Export as ZIP"
                                style="@style/TextAppearance.Zoron.BodyLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bundle all logs into a compressed archive"
                                style="@style/TextAppearance.Zoron.BodyMedium" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchZipExport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_section_divider"
                        android:layout_marginBottom="16dp" />

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsClearLogs"
                            style="@style/Widget.Zoron.Button.Pill.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Clear Data"
                            android:textColor="@color/error_red"
                            app:strokeColor="@color/error_red"
                            app:iconTint="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsExportLogs"
                            style="@style/Widget.Zoron.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Export Logs" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== ADVANCED ENGINE OPTIONS ==================== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/bg_section_divider"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADVANCED ENGINE"
                style="@style/TextAppearance.Zoron.LabelLarge"
                android:layout_marginBottom="16dp" />

            <!-- Fastpath Engine -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fastpath Engine"
                            style="@style/TextAppearance.Zoron.TitleMedium"
                            android:textColor="@color/purple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Quick-apply cached parameters before full engine run"
                            style="@style/TextAppearance.Zoron.BodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFastpath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Adaptive Mode Learning -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adaptive Learning"
                            style="@style/TextAppearance.Zoron.TitleMedium"
                            android:textColor="@color/purple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Learn usage patterns to optimize mode transitions"
                            style="@style/TextAppearance.Zoron.BodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAdaptiveLearning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Developer Mode -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Developer Mode"
                            style="@style/TextAppearance.Zoron.TitleMedium"
                            android:textColor="@color/purple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Enable advanced debugging and verbose output"
                            style="@style/TextAppearance.Zoron.BodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDevMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== DEVELOPER ATTRIBUTION ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsDeveloperAttribution"
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developed with ❤️ by Tausif Alam"
                        style="@style/TextAppearance.Zoron.TitleMedium"
                        android:textColor="@color/purple_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="aka buildwithtausif"
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub: github.com/buildwithtausif/zoron"
                        style="@style/TextAppearance.Zoron.Mono"
                        android:textColor="@color/info_blue"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
