<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Custom Rule"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IF THIS HAPPENS:"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerConditionType"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#222222"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etConditionValue"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Value (e.g. 50 or com.android.chrome)"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#222222"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THEN DO THIS:"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerActionType"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#222222"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etActionValue"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Value (e.g. deep or burst)"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#222222"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnSaveRule"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Save Rule"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF" />
</LinearLayout>
