<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fitsSystemWindows="true">

    <!-- ==================== APP BAR ==================== -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="ZORON-X"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Zoron.HeadlineLarge"
            app:titleTextColor="@color/purple_primary"
            app:menu="@menu/menu_main" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ==================== SCROLLABLE CONTENT ==================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="32dp">

        <LinearLayout
            style="@style/Widget.Zoron.Container"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== NON-ROOT PERMISSIONS CARD ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNonRootPermissions"
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔧 NON-ROOT CONFIGURATION"
                        style="@style/TextAppearance.Zoron.LabelLarge"
                        android:textColor="@color/warning_amber"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grant these permissions to allow Zoron-X to simulate battery saving profiles, toggle System Sync, and adjust display timeout/brightness offsets."
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantUsage"
                        style="@style/Widget.Zoron.Button.Pill.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Grant Usage stats access"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantWrite"
                        style="@style/Widget.Zoron.Button.Pill.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Grant Write System Settings"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantBattery"
                        style="@style/Widget.Zoron.Button.Pill.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Disable Battery Optimization" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== POWER STATE HERO CARD ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPowerState"
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POWER STATE"
                        style="@style/TextAppearance.Zoron.LabelLarge"
                        android:layout_marginBottom="16dp" />

                    <!-- State row: dot + state text -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:id="@+id/powerStateDot"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/power_state_dot" />

                        <TextView
                            android:id="@+id/tvPowerState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="DETECTING..."
                            android:textSize="26sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/purple_primary" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_section_divider"
                        android:layout_marginBottom="12dp" />

                    <!-- Profile info -->
                    <TextView
                        android:id="@+id/tvCurrentProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode: —"
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:drawablePadding="8dp"
                        android:layout_marginBottom="4dp" />

                    <!-- CPU info -->
                    <TextView
                        android:id="@+id/tvCpuInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU Governor: —"
                        style="@style/TextAppearance.Zoron.BodyMedium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== AUTOPILOT CARD ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutopilot"
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Autopilot Mode"
                            style="@style/TextAppearance.Zoron.TitleMedium"
                            android:textColor="@color/purple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Adapts to active apps and battery"
                            style="@style/TextAppearance.Zoron.BodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutopilot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== ZORON-X MODES SECTION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZORON-X MODES"
                style="@style/TextAppearance.Zoron.LabelLarge"
                android:layout_marginBottom="16dp" />

            <!-- Row 1: Balanced + Deep -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Balanced Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZoronBalanced"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.Zoron.Medium"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_mode_balanced">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="bottom"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡"
                                android:textSize="36sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Balanced"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart daily"
                                android:textSize="13sp"
                                android:textColor="@color/white_70" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Deep Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZoronDeep"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.Zoron.Medium"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_mode_deep">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="bottom"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔋"
                                android:textSize="36sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deep"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max battery"
                                android:textSize="13sp"
                                android:textColor="@color/white_70" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Hibernation + Burst -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Hibernation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZoronHibernation"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.Zoron.Medium"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_mode_hibernate">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="bottom"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="❄️"
                                android:textSize="36sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hibernate"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Extreme standby"
                                android:textSize="13sp"
                                android:textColor="@color/white_70" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Burst Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZoronBurst"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearance="@style/ShapeAppearance.Zoron.Medium"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_mode_burst">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="bottom"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🚀"
                                android:textSize="36sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Burst"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Race-to-idle"
                                android:textSize="13sp"
                                android:textColor="@color/white_70" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Nightwatch Card (full width) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardZoronNightwatch"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:shapeAppearance="@style/ShapeAppearance.Zoron.Medium"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_mode_nightwatch">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌙"
                            android:textSize="42sp"
                            android:layout_marginEnd="20dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nightwatch"
                                android:textSize="22sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ultra deep overnight preservation"
                                android:textSize="13sp"
                                android:textColor="@color/white_50" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== TRANSITION PROGRESS ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTransitionProgress"
                style="@style/Widget.Zoron.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvTransitionStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Applying..."
                            style="@style/TextAppearance.Zoron.TitleMedium"
                            android:textColor="@color/purple_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHideProgress"
                            style="@style/Widget.Zoron.Button.Pill.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Hide"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/transitionProgressBar"
                        style="@style/Widget.Zoron.ProgressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <!-- Detail text -->
                    <TextView
                        android:id="@+id/tvTransitionDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Initializing..."
                        style="@style/TextAppearance.Zoron.Mono" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== LEGACY PROFILES (COLLAPSIBLE) ==================== -->
            <LinearLayout
                android:id="@+id/legacyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LEGACY PROFILES"
                    style="@style/TextAppearance.Zoron.LabelLarge" />

                <ImageView
                    android:id="@+id/ivLegacyToggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_expand"
                    android:contentDescription="Toggle legacy profiles" />

                <!-- Hidden compat view -->
                <TextView
                    android:id="@+id/tvLegacyToggle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/legacyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <!-- Row 1: None + Battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNone"
                        style="@style/Widget.Zoron.Card.Glass"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:foreground="@drawable/ripple_card"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📱"
                                android:textSize="28sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/purple_on_surface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBattery"
                        style="@style/Widget.Zoron.Card.Glass"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:foreground="@drawable/ripple_card"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔋"
                                android:textSize="28sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/purple_on_surface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2: Balanced + Performance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBalanced"
                        style="@style/Widget.Zoron.Card.Glass"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:foreground="@drawable/ripple_card"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚖️"
                                android:textSize="28sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Balanced"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/purple_on_surface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPerformance"
                        style="@style/Widget.Zoron.Card.Glass"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:foreground="@drawable/ripple_card"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡"
                                android:textSize="28sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perform"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/purple_on_surface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== ANALYTICS SECTION ==================== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/bg_section_divider"
                android:layout_marginBottom="20dp" />

            <!-- Analytics header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ANALYTICS"
                    style="@style/TextAppearance.Zoron.LabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCsv"
                    style="@style/Widget.Zoron.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Export"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvChartInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battery drain over time"
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/batteryChart"
                        android:layout_width="match_parent"
                        android:layout_height="280dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== PROCESS MONITOR ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PROCESS MONITOR"
                    style="@style/TextAppearance.Zoron.LabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportProcesses"
                    style="@style/Widget.Zoron.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Export"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvProcessReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading process data..."
                        style="@style/TextAppearance.Zoron.Mono" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== DIAGNOSTICS ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DIAGNOSTICS"
                    style="@style/TextAppearance.Zoron.LabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLogs"
                    style="@style/Widget.Zoron.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Export"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading logs..."
                        style="@style/TextAppearance.Zoron.Mono"
                        android:textColor="@color/purple_primary"
                        android:textSize="13sp" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== DEVELOPER ATTRIBUTION ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeveloperAttribution"
                style="@style/Widget.Zoron.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developed with ❤️ by Tausif Alam"
                        style="@style/TextAppearance.Zoron.TitleMedium"
                        android:textColor="@color/purple_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="aka buildwithtausif"
                        style="@style/TextAppearance.Zoron.BodyMedium"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub: github.com/buildwithtausif/zoron"
                        style="@style/TextAppearance.Zoron.Mono"
                        android:textColor="@color/info_blue"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
